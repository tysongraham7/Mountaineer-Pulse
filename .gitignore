# --- Secrets (NEVER commit) ---
.env
**/.env

# Service account private keys. Two different ones pass through this project — Firebase
# (FCM push) and Google Play (eas submit) — and both are real credentials that live outside
# the repo and get handed to EAS. Patterns are deliberately narrow so they can't swallow
# mobile/google-services.json, which is client config and MUST stay tracked or EAS Build
# won't receive it.
*-firebase-adminsdk-*.json
*service-account*.json

# --- Python ---
__pycache__/
**/__pycache__/
*.pyc
.venv/
venv/

# --- Node / Expo ---
node_modules/
**/node_modules/
.expo/
**/.expo/
mobile/dist/
mobile/web-build/
dist/
*.tsbuildinfo

# --- Personal Claude Code settings (local only) ---
.claude/settings.local.json

# --- Misc ---
.DS_Store
*.log
